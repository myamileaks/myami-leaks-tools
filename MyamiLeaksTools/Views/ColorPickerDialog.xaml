<Window x:Class="MyamiLeaksTools.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick Color" Width="320" Height="380"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Border Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource BorderSubtle}"
            BorderThickness="1" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Opacity="0.7"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="COLOR PICKER" Style="{StaticResource PageTitle}"
                           FontSize="18"/>
                <TextBlock Text="Adjust RGB or enter hex value"
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <!-- controls -->
            <StackPanel Grid.Row="1">
                <!-- preview swatch -->
                <Border x:Name="PreviewSwatch" Height="48" CornerRadius="8"
                        Margin="0,0,0,16" Background="#FF0000">
                    <Border.Effect>
                        <DropShadowEffect Color="#CC1020" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                    </Border.Effect>
                </Border>

                <!-- R -->
                <Label Content="Red" Foreground="{StaticResource TextSecondary}" Padding="0,2"/>
                <Slider x:Name="SliderR" Minimum="0" Maximum="255" Value="255"
                        ValueChanged="Channel_Changed" Margin="0,2,0,10"/>

                <!-- G -->
                <Label Content="Green" Foreground="{StaticResource TextSecondary}" Padding="0,2"/>
                <Slider x:Name="SliderG" Minimum="0" Maximum="255" Value="0"
                        ValueChanged="Channel_Changed" Margin="0,2,0,10"/>

                <!-- B -->
                <Label Content="Blue" Foreground="{StaticResource TextSecondary}" Padding="0,2"/>
                <Slider x:Name="SliderB" Minimum="0" Maximum="255" Value="0"
                        ValueChanged="Channel_Changed" Margin="0,2,0,16"/>

                <!-- hex input -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="#" Foreground="{StaticResource TextSecondary}"
                               FontFamily="Consolas" FontSize="14" VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBox x:Name="HexBox" Grid.Column="1" FontFamily="Consolas"
                             Text="FF0000" MaxLength="6"
                             TextChanged="Hex_Changed"/>
                </Grid>
            </StackPanel>

            <!-- buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Content="Cancel" Style="{StaticResource BtnGhost}"
                        Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Apply" Style="{StaticResource BtnPrimary}"
                        Click="Apply_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
