<UserControl x:Class="MyamiLeaksTools.Views.TimecycleEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BgDeep}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="Open timecycle_v.xml" Style="{StaticResource BtnGhost}" Click="Open_Click" Margin="0,0,8,0"/>
                <Button Content="Save" Style="{StaticResource BtnPrimary}" Click="Save_Click" Margin="0,0,8,0"/>
                <ComboBox x:Name="CbWeather" Width="160" Margin="16,0,8,0"
                          SelectionChanged="Weather_Changed">
                    <ComboBoxItem Content="EXTRASUNNY" IsSelected="True"/>
                    <ComboBoxItem Content="CLEAR"/>
                    <ComboBoxItem Content="CLOUDS"/>
                    <ComboBoxItem Content="SMOG"/>
                    <ComboBoxItem Content="FOGGY"/>
                    <ComboBoxItem Content="OVERCAST"/>
                    <ComboBoxItem Content="RAIN"/>
                    <ComboBoxItem Content="THUNDER"/>
                    <ComboBoxItem Content="SNOW"/>
                    <ComboBoxItem Content="BLIZZARD"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- XML editor -->
            <Border Style="{StaticResource Card}" Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="RAW XML EDITOR" Foreground="{StaticResource TextMuted}"
                               FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1">
                        <TextBox x:Name="XmlEditor" FontFamily="Consolas" FontSize="12"
                                 Background="Transparent" Foreground="{StaticResource TextPrimary}"
                                 BorderThickness="0" AcceptsReturn="True"
                                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                                 Text="&lt;!-- Open a timecycle_v.xml file to edit --&gt;"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- parameter sliders -->
            <ScrollViewer Grid.Column="2">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="LIGHTING" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <Label Content="Sun Intensity"/>
                            <Slider Minimum="0" Maximum="10" Value="4.5" Margin="0,2,0,8"/>
                            <Label Content="Shadow Darkness"/>
                            <Slider Minimum="0" Maximum="1" Value="0.6" Margin="0,2,0,8"/>
                            <Label Content="HDR Scale"/>
                            <Slider Minimum="0" Maximum="4" Value="1.0" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ATMOSPHERE" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <Label Content="Fog Start"/>
                            <Slider Minimum="0" Maximum="5000" Value="500" Margin="0,2,0,8"/>
                            <Label Content="Fog Density"/>
                            <Slider Minimum="0" Maximum="1" Value="0.1" Margin="0,2,0,8"/>
                            <Label Content="Far Clip"/>
                            <Slider Minimum="100" Maximum="10000" Value="3500" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="BLOOM" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <Label Content="Bloom Intensity"/>
                            <Slider Minimum="0" Maximum="3" Value="0.8" Margin="0,2,0,8"/>
                            <Label Content="Bloom Threshold"/>
                            <Slider Minimum="0" Maximum="2" Value="0.5" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
