<UserControl x:Class="MyamiLeaksTools.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BgDeep}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="Select Pack Folder" Style="{StaticResource BtnGhost}" Click="Primary_Click" Margin="0,0,8,0"/>
                <Button Content="Save / Apply" Style="{StaticResource BtnPrimary}" Click="Apply_Click"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="16">
            <Border Style="{StaticResource Card}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Performance Optimizer" Foreground="{StaticResource TextPrimary}"
                               FontSize="20" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Analyze and optimize pack particle XML files — remove redundant keyframes, reduce overdraw"
                               Foreground="{StaticResource TextSecondary}" FontSize="13"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="480"
                               Margin="0,0,0,24"/>
                    <Button Content="Select Pack Folder" Style="{StaticResource BtnPrimary}"
                            HorizontalAlignment="Center" Click="Primary_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
