<UserControl x:Class="MyamiLeaksTools.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header banner -->
        <Border Grid.Row="0" Padding="28,22,28,18"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0C0508" Offset="0"/>
                    <GradientStop Color="#08080C" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <!-- red glow behind title -->
                <Ellipse Width="200" Height="80" HorizontalAlignment="Left" VerticalAlignment="Center"
                         Margin="-30,0,0,0" Opacity="0.08">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF1830" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="MYAMI LEAKS TOOLS"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Premium GTA V / FiveM modding suite — all tools in one place"/>
                    <!-- Tag row -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Border Background="#1A0308" BorderBrush="#4A0810" BorderThickness="1"
                                CornerRadius="5" Padding="8,3" Margin="0,0,6,0">
                            <TextBlock Text="16 Tools" FontSize="10" Foreground="#CC1020"/>
                        </Border>
                        <Border Background="#0C1A10" BorderBrush="#1A4A28" BorderThickness="1"
                                CornerRadius="5" Padding="8,3" Margin="0,0,6,0">
                            <TextBlock Text="EN / ES / FR" FontSize="10" Foreground="#30CC70"/>
                        </Border>
                        <Border Background="#0C0C18" BorderBrush="#1E1E38" BorderThickness="1"
                                CornerRadius="5" Padding="8,3">
                            <TextBlock Text="CodeWalker Integrated" FontSize="10" Foreground="#5050A0"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tool card grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16,20,20">
            <ItemsControl x:Name="ToolsGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
