<UserControl x:Class="MyamiLeaksTools.Views.RPFEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BgDeep}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <Border Grid.Row="0" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="Open RPF" Style="{StaticResource BtnGhost}" Click="OpenRPF_Click" Margin="0,0,8,0"/>
                <Button Content="Extract Selected" Style="{StaticResource BtnGhost}" Click="Extract_Click" Margin="0,0,8,0"/>
                <Button Content="Inject File" Style="{StaticResource BtnPrimary}" Click="Inject_Click" Margin="0,0,8,0"/>
                <Separator Width="1" Height="20" Background="{StaticResource BorderSubtle}" Margin="4,0"/>
                <Button Content="Set CodeWalker Path" Style="{StaticResource BtnGhost}" Click="SetCwPath_Click" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- file tree + preview -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- file tree -->
            <Border Style="{StaticResource Card}" Grid.Column="0" Padding="0">
                <TreeView x:Name="RpfTree" Background="Transparent"
                          BorderThickness="0" ItemContainerStyle="{x:Null}"
                          SelectedItemChanged="RpfTree_SelectedItemChanged">
                    <TreeView.Resources>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="4,3"/>
                        </Style>
                    </TreeView.Resources>
                </TreeView>
            </Border>

            <!-- entry details -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="EntryName" Text="Select a file from the tree"
                               Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="EntryPath" Text=""
                               Foreground="{StaticResource TextSecondary}" FontSize="11"
                               FontFamily="Consolas" Margin="0,0,0,4"/>
                    <TextBlock x:Name="EntrySize" Text=""
                               Foreground="{StaticResource TextMuted}" FontSize="11"
                               Margin="0,0,0,16"/>

                    <Separator/>

                    <!-- hex preview placeholder -->
                    <ScrollViewer Height="300" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="HexPreview" IsReadOnly="True"
                                 Background="Transparent" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="11"
                                 Foreground="{StaticResource TextSecondary}"
                                 TextWrapping="Wrap"
                                 Text="[No file selected]"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>

        <!-- status -->
        <Border Grid.Row="2" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0"
                Padding="16,8">
            <TextBlock x:Name="RpfStatus" Text="No RPF loaded"
                       Foreground="{StaticResource TextMuted}" FontSize="11"/>
        </Border>
    </Grid>
</UserControl>
