<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ─── COLOR TOKENS ───────────────────────────────────────────── -->
    <Color x:Key="BgDeepColor">#050508</Color>
    <Color x:Key="BgPanelColor">#0C0C0F</Color>
    <Color x:Key="BgCardColor">#111115</Color>
    <Color x:Key="BgGlassColor">#18181E</Color>
    <Color x:Key="BgHoverColor">#1E1E26</Color>
    <Color x:Key="AccentRedColor">#CC1020</Color>
    <Color x:Key="AccentRedGlowColor">#FF1830</Color>
    <Color x:Key="AccentBurgundyColor">#7A0818</Color>
    <Color x:Key="AccentPinkColor">#FF2850</Color>
    <Color x:Key="TextPrimaryColor">#F4F4F8</Color>
    <Color x:Key="TextSecondaryColor">#7878A0</Color>
    <Color x:Key="TextMutedColor">#38383E</Color>
    <Color x:Key="BorderSubtleColor">#1E1E28</Color>
    <Color x:Key="BorderRedColor">#4A0810</Color>
    <Color x:Key="SuccessColor">#30CC70</Color>
    <Color x:Key="WarningColor">#FFB030</Color>
    <Color x:Key="ErrorColor">#FF1830</Color>

    <SolidColorBrush x:Key="BgDeep"       Color="{StaticResource BgDeepColor}"/>
    <SolidColorBrush x:Key="BgPanel"      Color="{StaticResource BgPanelColor}"/>
    <SolidColorBrush x:Key="BgCard"       Color="{StaticResource BgCardColor}"/>
    <SolidColorBrush x:Key="BgGlass"      Color="{StaticResource BgGlassColor}"/>
    <SolidColorBrush x:Key="BgHover"      Color="{StaticResource BgHoverColor}"/>
    <SolidColorBrush x:Key="AccentRed"    Color="{StaticResource AccentRedColor}"/>
    <SolidColorBrush x:Key="AccentGlow"   Color="{StaticResource AccentRedGlowColor}"/>
    <SolidColorBrush x:Key="AccentBurgundy" Color="{StaticResource AccentBurgundyColor}"/>
    <SolidColorBrush x:Key="AccentPink"   Color="{StaticResource AccentPinkColor}"/>
    <SolidColorBrush x:Key="TextPrimary"  Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMuted"    Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="BorderRed"    Color="{StaticResource BorderRedColor}"/>
    <SolidColorBrush x:Key="Success"      Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="Warning"      Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="Error"        Color="{StaticResource ErrorColor}"/>

    <!-- Accent alias for views -->
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentRedColor}"/>

    <!-- gradients -->
    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0A0408" Offset="0"/>
        <GradientStop Color="#08080C" Offset="0.5"/>
        <GradientStop Color="#0A0408" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0D0D12" Offset="0"/>
        <GradientStop Color="#090910" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RedGlowGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#CC1020" Offset="0"/>
        <GradientStop Color="#FF2850" Offset="1"/>
    </LinearGradientBrush>

    <!-- glass card brush -->
    <LinearGradientBrush x:Key="GlassGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1E1E26" Offset="0"/>
        <GradientStop Color="#12121A" Offset="1"/>
    </LinearGradientBrush>

    <!-- abstract bg radial glow (red, behind everything) -->
    <RadialGradientBrush x:Key="BgRedGlow" Center="0.8,0.15" RadiusX="0.4" RadiusY="0.4">
        <GradientStop Color="#1A0408" Offset="0"/>
        <GradientStop Color="Transparent" Offset="1"/>
    </RadialGradientBrush>

    <!-- fonts -->
    <FontFamily x:Key="UIFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>

    <!-- ─── SCROLLBAR ──────────────────────────────────────────────── -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{StaticResource BorderRed}"
                                                    CornerRadius="3" Margin="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─── BUTTON — PRIMARY (red gradient) ───────────────────────── -->
    <Style x:Key="BtnPrimary" TargetType="Button">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#CC1020" Offset="0"/>
                                <GradientStop Color="#FF2850" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#CC1020" BlurRadius="12"
                                              ShadowDepth="0" Opacity="0.5"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─── BUTTON — GHOST ─────────────────────────────────────────── -->
    <Style x:Key="BtnGhost" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource BgHover}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BorderRed}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─── SIDEBAR NAV ITEM — burgundy pill ─────────────────────── -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="NavGroup"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Margin="8,1">
                        <!-- pill bg -->
                        <Border x:Name="Pill" Background="Transparent" CornerRadius="8"/>
                        <!-- red indicator bar -->
                        <Border x:Name="Bar" Width="3" CornerRadius="2"
                                HorizontalAlignment="Left" Margin="2,6,0,6"
                                Background="{StaticResource AccentGlow}" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource BgHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#280208"/>
                            <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─── TEXTBOX ─────────────────────────────────────────────────── -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BgCard}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentRed}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                      Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─── COMBOBOX ────────────────────────────────────────────────── -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource BgCard}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>

    <!-- ─── SLIDER — thin pink/red ──────────────────────────────────── -->
    <Style TargetType="Slider">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Track x:Name="PART_Track" Grid.Row="1">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{x:Null}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="3" CornerRadius="2">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#CC1020" Offset="0"/>
                                                        <GradientStop Color="#FF2850" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{x:Null}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="3" Background="{StaticResource BorderSubtle}" CornerRadius="2"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="12" Height="12">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource AccentPink}"
                                                     Stroke="{StaticResource BgDeep}"
                                                     StrokeThickness="2">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="#FF2850" BlurRadius="6"
                                                                      ShadowDepth="0" Opacity="0.8"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─── LABEL ────────────────────────────────────────────────────── -->
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Padding" Value="0,2"/>
    </Style>

    <!-- ─── GLASS CARD ──────────────────────────────────────────────── -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassGradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="16"
                                  ShadowDepth="4" Opacity="0.6"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─── TOOL CARD (home screen grid) ────────────────────────────── -->
    <Style x:Key="ToolCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassGradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.5"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─── SECTION HEADER ──────────────────────────────────────────── -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="20,14,0,4"/>
    </Style>

    <!-- ─── SEPARATOR ───────────────────────────────────────────────── -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="16,6"/>
    </Style>

    <!-- ─── PAGE TITLE (large bold italic) ──────────────────────────── -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Black"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

</ResourceDictionary>
